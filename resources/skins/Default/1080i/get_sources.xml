            <control type="grouplist">
                <left>0</left>
                <top>115</top>
                <width>1300</width>
                <height>40</height>
                <orientation>horizontal</orientation>
                <itemgap>40</itemgap>
                <control type="label">
                    <width>auto</width>
                    <height>40</height>
                    <font>Reg26</font>
                    <textcolor>$INFO[Skin.String(BingieDeatailsTextColor)]</textcolor>
                    <label>Total  [COLOR $INFO[Skin.String(GeneralTextColor)]][B]$INFO[Window().Property(totals_total)][/B][/COLOR]</label>
                </control>
                <control type="label">
                    <width>auto</width>
                    <height>40</height>
